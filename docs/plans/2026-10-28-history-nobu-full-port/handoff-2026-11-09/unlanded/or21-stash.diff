+/// The owner's stash in its economy (courier spec §2): whether the match runs the stash rule,
+/// and the catalog id of each stash slot (0 empty).
+#[derive(Clone, Debug, Default, Eq, Ord, PartialEq, PartialOrd, Serialize, Deserialize)]
+pub struct OwnerStash {
+    pub enabled: bool,
+    pub item_ids: [u16; 6],
+}
+
+impl OwnerStash {
+    pub const PAYLOAD_LEN: usize = 13;
+
+    pub fn capture(enabled: bool, stash: &Inventory) -> Result<Self, &'static str> {
+        let mut state = Self { enabled, item_ids: [0; 6] };
+        for (slot, item) in stash.items() {
+            state.item_ids[slot] = omoba_template_ids::MOBA_ITEM_CATALOG.iter().find(|entry| entry.id == item.item_id)
+                .ok_or("unknown MOBA catalog item")?.catalog_id;
+        }
+        Ok(state)
+    }
+
+    pub fn encode(&self) -> Vec<u8> {
+        let mut bytes = Vec::with_capacity(Self::PAYLOAD_LEN);
+        bytes.push(u8::from(self.enabled));
+        for id in self.item_ids { bytes.extend(id.to_le_bytes()); }
+        bytes
+    }
+
+    /// Only a known catalog id or 0 in each slot, and no stash without the rule.
+    pub fn decode(bytes: &[u8]) -> Option<Self> {
+        if bytes.len() != Self::PAYLOAD_LEN || bytes[0] > 1 { return None; }
+        let mut state = Self { enabled: bytes[0] == 1, item_ids: [0; 6] };
+        for slot in 0..6 {
+            let id = u16::from_le_bytes(bytes[1 + slot * 2..3 + slot * 2].try_into().ok()?);
+            if id != 0 && (!state.enabled || !omoba_template_ids::MOBA_ITEM_CATALOG.iter().any(|entry| entry.catalog_id == id)) { return None; }
+            state.item_ids[slot] = id;
+        }
+        Some(state)
+    }
+}
