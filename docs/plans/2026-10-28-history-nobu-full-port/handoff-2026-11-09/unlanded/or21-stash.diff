+/// Courier spec §2 (`shop_range_rule`): a purchase within the shop lands in the inventory, or the
+/// stash when the inventory is full; outside it (or while dead) in the stash; a full stash refuses
+/// ([`ShopError::StashFull`]). A recipe takes its parts from the inventory and the stash within
+/// the shop, from the stash only outside it. Selling stays within the shop (or while dead, as
+/// before), from the inventory or the stash. Only a purchase that touched neither the stash nor
+/// the stash's parts keeps its undo record; any other transaction closes the owner's undo.
+fn transact_with_stash(world: &mut World, player_id: u32, command: ShopCommand) -> Result<(), ShopError> {
+    use super::comp::ItemEffects;
+    let (seat, in_range) = {
+        let state = world.try_fetch::<super::moba_match::MobaMatch>().ok_or(ShopError::MatchUnavailable)?;
+        match classify_shop(world, &state, player_id) {
+            Ok(ShopSeat::Live(hero)) => (ShopSeat::Live(hero), true),
+            Ok(ShopSeat::Retained) => (ShopSeat::Retained, false),
+            // a living hero outside its shop (classify_shop checked the rest first)
+            Err((ShopError::OutsideShop, _)) => (ShopSeat::Live(state.heroes.iter().find(|slot| slot.player_id == player_id)
+                .and_then(|slot| slot.entity).ok_or(ShopError::HeroUnavailable)?), false),
+            Err((error, _)) => return Err(error),
+        }
+    };
+    if matches!(command, ShopCommand::Sell(_) | ShopCommand::SellStash(_)) && matches!(seat, ShopSeat::Live(_)) && !in_range {
+        return Err(ShopError::OutsideShop);
+    }
+    if let ShopCommand::Buy(id) = &command {
+        if !omoba_template_ids::MOBA_ITEM_CATALOG.iter().any(|item| item.id == *id && (item.in_shop() || SELLS_TEST_ONLY_ITEMS)) {
+            return Err(ShopError::UnknownItem);
+        }
+    }
+    let registry = (*world.read_resource::<ItemRegistry>()).clone();
+    let mut state = world.write_resource::<super::moba_match::MobaMatch>();
+    let slot = state.heroes.iter_mut().find(|slot| slot.player_id == player_id).ok_or(ShopError::UnknownPlayer)?;
+    let mut inventories = world.write_storage::<Inventory>();
+    let mut balances = world.write_storage::<Gold>();
+    let (inventory, gold, stash, source) = match seat {
+        ShopSeat::Live(hero) => (inventories.get_mut(hero).ok_or(ShopError::MissingComponents)?,
+            balances.get_mut(hero).ok_or(ShopError::MissingComponents)?, &mut slot.stash, (hero.id(), hero.gen().id())),
+        ShopSeat::Retained => {
+            let (inventory, gold, stash) = slot.admitted_dead_wallet_and_stash().ok_or(ShopError::HeroUnavailable)?;
+            (inventory, gold, stash, (SHOP_UNDO_ROSTER_INDEX, SHOP_UNDO_ROSTER_GENERATION))
+        }
+    };
+    let before_inventory = inventory.clone();
+    let before_gold = gold.0;
+    let record = match command {
+        ShopCommand::Buy(id) => {
+            let (placed, used_stash) = buy_with_stash(&registry, inventory, stash, gold, &id, in_range)?;
+            let paid = before_gold.checked_sub(gold.0).filter(|paid| *paid >= 0).ok_or(ShopError::InvalidBalance)?;
+            match placed {
+                StashPlacement::Inventory(result) if !used_stash => Some((purchase_record(
+                    &registry, &before_inventory, inventory, result, &id, paid, source.0, source.1), inventory.clone())),
+                _ => None,
+            }
+        }
+        ShopCommand::Sell(index) => {
+            let sold = inventory.slots.get(index).and_then(Option::as_ref).cloned().ok_or(ShopError::InvalidSlot)?;
+            if !sold.cooldown_remaining.is_finite() || sold.cooldown_remaining < 0.0 { return Err(ShopError::InvalidCatalog); }
+            let credit = sell_item(&registry, inventory, gold, index)?;
+            Some((ShopUndoRecord {
+                kind: ShopUndoKind::Sale, sequence: 0, item_id: sold.item_id,
+                result_slot: index as u8, result_cooldown_bits: sold.cooldown_remaining.to_bits(),
+                paid: credit, consumed: Vec::new(), benefits: BENEFIT_ATTACK | BENEFIT_HP | BENEFIT_ARMOR | BENEFIT_MOVE,
+                eligible: true, source_index: source.0, source_generation: source.1,
+            }, inventory.clone()))
+        }
+        ShopCommand::SellStash(index) => { sell_item(&registry, stash, gold, index)?; None }
+    };
+    let changed_inventory = inventory.slots.iter().zip(&before_inventory.slots)
+        .any(|(now, was)| now.as_ref().map(|item| &item.item_id) != was.as_ref().map(|item| &item.item_id));
+    drop((inventories, balances, state));
+    if let (true, ShopSeat::Live(hero)) = (changed_inventory, seat) {
+        if let Some(effects) = world.write_storage::<ItemEffects>().get_mut(hero) { effects.dirty = true; }
+    }
+    match record {
+        Some((record, inventory)) => commit_transaction(world, player_id, record, &inventory),
+        None => if let Some(mut ledger) = world.try_fetch_mut::<ShopUndoLedger>() { ledger.invalidate_player(player_id); },
+    }
+    Ok(())
+}
