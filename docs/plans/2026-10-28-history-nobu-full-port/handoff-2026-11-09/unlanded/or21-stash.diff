+/// Where a stash-rule purchase landed.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum StashPlacement { Inventory(usize), Stash(usize) }
+
+/// [`buy_item`] under the stash rule (courier spec §2). Within the shop (`in_range`) the parts come
+/// from the inventory first, then the stash, and the item lands in a free inventory slot, else in
+/// the stash; outside it, the parts come from the stash only and the item lands there. A full
+/// stash is [`ShopError::StashFull`]. `true` with the placement: some part came from the stash.
+pub fn buy_with_stash(registry: &ItemRegistry, inventory: &mut Inventory, stash: &mut Inventory, gold: &mut Gold,
+    item_id: &str, in_range: bool) -> Result<(StashPlacement, bool), ShopError> {
+    if gold.0 < 0 { return Err(ShopError::InvalidBalance); }
+    let item = registry.get(item_id).ok_or(ShopError::UnknownItem)?;
+    if !valid_item(&item) { return Err(ShopError::InvalidCatalog); }
+    let mut component_costs = Vec::with_capacity(item.recipe.len());
+    for id in &item.recipe {
+        if id == item_id { return Err(ShopError::InvalidCatalog); }
+        let component = registry.get(id).ok_or(ShopError::InvalidCatalog)?;
+        if !valid_item(&component) { return Err(ShopError::InvalidCatalog); }
+        component_costs.push(component.cost);
+    }
+    let price = checked_combine_price(item.cost, &component_costs)?;
+    let (mut carried, mut stored, mut used_stash) = (inventory.clone(), stash.clone(), false);
+    for id in &item.recipe {
+        if let Some(slot) = carried.find_item(id).filter(|_| in_range) { carried.slots[slot] = None; continue; }
+        let slot = stored.find_item(id).ok_or(ShopError::MissingComponent)?;
+        stored.slots[slot] = None;
+        used_stash = true;
+    }
+    if gold.0 < price { return Err(ShopError::InsufficientGold); }
+    let instance = ItemInstance { item_id: item_id.to_owned(), cooldown_remaining: 0.0 };
+    let placed = match carried.first_free_slot().filter(|_| in_range) {
+        Some(slot) => {
+            carried.slots[slot] = Some(instance);
+            validate_inventory_purchase_groups(registry, &carried)?;
+            StashPlacement::Inventory(slot)
+        }
+        None => {
+            let slot = stored.first_free_slot().ok_or(ShopError::StashFull)?;
+            stored.slots[slot] = Some(instance);
+            StashPlacement::Stash(slot)
+        }
+    };
+    *inventory = carried;
+    *stash = stored;
+    gold.0 -= price;
+    Ok((placed, used_stash))
+}
