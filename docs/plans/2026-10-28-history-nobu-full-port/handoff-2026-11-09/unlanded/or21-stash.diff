+/// Whether the inventory keeps within its equipment groups (a stash pickup's check).
+pub(crate) fn inventory_purchase_groups_allow(registry: &ItemRegistry, inventory: &Inventory) -> bool {
+    validate_inventory_purchase_groups(registry, inventory).is_ok()
+}
