+/// Dota's stash pickup (courier spec §2, `shop_range_rule` only): a living hero within its shop
+/// moves its stash's items into its free inventory slots, in stash order, before this tick's
+/// economy is committed; an item its equipment groups refuse stays in the stash. Its item stats
+/// follow (ItemEffects dirty).
+pub(crate) fn pick_up_stash(world: &World, state: &mut MobaMatch) {
+    if !state.config.shop_range_rule { return; }
+    let waiting: Vec<(usize, Entity)> = state.heroes.iter().enumerate()
+        .filter(|(_, slot)| slot.stash.items().next().is_some())
+        .filter_map(|(index, slot)| slot.entity.filter(|_| super::shop::in_shop_range(world, state, slot.player_id)).map(|hero| (index, hero)))
+        .collect();
+    let registry = world.read_resource::<super::item::ItemRegistry>();
+    for (index, hero) in waiting {
+        let mut inventories = world.write_storage::<Inventory>();
+        let Some(inventory) = inventories.get_mut(hero) else { continue };
+        let stash = &mut state.heroes[index].stash;
+        let mut moved = false;
+        for stash_slot in 0..stash.slots.len() {
+            let Some(free) = inventory.first_free_slot() else { break };
+            let Some(item) = stash.slots[stash_slot].clone() else { continue };
+            let mut next = inventory.clone();
+            next.slots[free] = Some(item);
+            if super::shop::inventory_purchase_groups_allow(&registry, &next) {
+                *inventory = next;
+                stash.slots[stash_slot] = None;
+                moved = true;
+            }
+        }
+        drop(inventories);
+        if moved {
+            if let Some(effects) = world.write_storage::<ItemEffects>().get_mut(hero) { effects.dirty = true; }
+        }
+    }
+}
