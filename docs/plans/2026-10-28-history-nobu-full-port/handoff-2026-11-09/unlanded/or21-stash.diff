+/// Whether `player_id`'s living hero stands within its shop (the seat an ordinary purchase
+/// needs); a dead hero's roster wallet is not.
+pub(crate) fn in_shop_range(world: &World, state: &super::moba_match::MobaMatch, player_id: u32) -> bool {
