+    /// A courier is UnitType::Courier, yet its owner commands it as a summon (summon_orders).
+    #[test]
+    fn the_owner_moves_its_courier_like_a_summon() {
+        let (mut world, mut driver) = world(true);
+        while world.read_resource::<MobaMatch>().phase == MobaMatchPhase::Warmup { driver.step(&mut world, Vec::new()).unwrap(); }
+        let (owner, courier, spawn) = {
+            let state = world.read_resource::<MobaMatch>();
+            let slot = state.heroes.iter().find(|slot| slot.player_id == 1).unwrap();
+            (slot.entity.unwrap(), courier_of(&world, &state, 1).unwrap(), slot.courier_spawn.unwrap())
+        };
+        let to = spawn + Vec2::new(Fixed64::from_i32(200), Fixed64::ZERO);
+        let order = crate::game_proto::OwnedSummonOrder { owner_entity: owner.id(), owner_generation: owner.gen().id() as u32,
+            summon_entity: courier.id(), summon_generation: courier.gen().id() as u32, operation: 1,
+            point: Some(crate::game_proto::Vec2I { x: to.x.raw() as i32, y: to.y.raw() as i32 }), ability: String::new(), target: None };
+        assert_eq!(crate::runtime::native::summon_orders::apply(&mut world, 1, owner, &order), Ok(()), "the owner may move its courier");
+        let other = state_entity(&world, 2);
+        assert!(crate::runtime::native::summon_orders::apply(&mut world, 2, other, &crate::game_proto::OwnedSummonOrder {
+            owner_entity: other.id(), owner_generation: other.gen().id() as u32, ..order.clone() }).is_err(), "another player may not");
+
+    }
+
+    fn state_entity(world: &World, player_id: u32) -> Entity {
+        world.read_resource::<MobaMatch>().heroes.iter().find(|slot| slot.player_id == player_id).and_then(|slot| slot.entity).unwrap()
+    }
 }
